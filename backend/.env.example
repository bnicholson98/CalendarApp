DEBUG=True

# Required when DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Comma-separated; only needed when DEBUG is off.
ALLOWED_HOSTS=
# Comma-separated, e.g. https://calendar.example.com; only used when DEBUG is off.
CORS_ALLOWED_ORIGINS=

# Database: "mssql" (default) or "sqlite" (a local db.sqlite3 file, no server needed).
DB_ENGINE=mssql
DB_NAME=CalendarAppDB
DB_HOST=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 17 for SQL Server
# Leave both empty to use Windows authentication.
DB_USER=
DB_PASSWORD=
